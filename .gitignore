# --- secrets and local environment (never commit) ---
deploy/compose/.env
deploy/compose/secrets/*
!deploy/compose/secrets/README.md
!deploy/compose/secrets/.gitkeep
.env
*.local

# --- Python ---
backend/.venv/
backend/.python-version
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Angular ---
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/e2e/test-output/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- editors / OS ---
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# --- research captures (may contain personal data) ---
tools/research/tasge/capture*/
tools/research/tasge/files/
tools/research/tasge/png/
tools/research/tasge/node_modules/
tools/research/tasge/*.json
!tools/research/tasge/sample/*.json
