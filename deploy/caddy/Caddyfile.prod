{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
	on_demand_tls {
		# 2xx allows issuance; anything else fails the TLS handshake (unknown-host rejection).
		# The token is the internal_ask_token secret, exported by the container entrypoint.
		ask http://api:8000/internal/domains/ask?token={$UF_INTERNAL_ASK_TOKEN}
	}
	metrics
	servers {
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(api_routes) {
	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000 {
			lb_policy round_robin
			health_uri /internal/health/live
		}
	}
	handle /auth/* {
		request_body {
			max_size 64KB
		}
		rate_limit {
			zone auth_by_ip {
				key {remote_host}
				events 60
				window 1m
			}
		}
		reverse_proxy api:8000
	}
	# Internal endpoints are never reachable from the internet.
	handle /internal/* {
		respond 404
	}
}

# Marketing site.
{$PLATFORM_DOMAIN}, www.{$PLATFORM_DOMAIN} {
	import security_headers
	reverse_proxy web-site:8080
}

# Staff workspace + Kratos public API under /.ory/ (same host → first-party cookies).
app.{$PLATFORM_DOMAIN} {
	import security_headers
	import api_routes
	# MCP server for staff assistants (ADR-0015): bearer API tokens, never a cookie, app host only.
	handle /mcp* {
		request_body {
			max_size 1MB
		}
		rate_limit {
			zone mcp_by_ip {
				key {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy api:8000 {
			lb_policy round_robin
			health_uri /internal/health/live
		}
	}
	handle_path /.ory/* {
		rate_limit {
			zone ory_by_ip {
				key {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy kratos:4433
	}
	handle {
		reverse_proxy web-admin:8080
	}
}

# S3 API of the object store for browser uploads/downloads via presigned URLs (bucket policy + CORS set by init-garage.sh).
s3.{$PLATFORM_DOMAIN} {
	request_body {
		max_size 2GB
	}
	reverse_proxy storage:3900
}

# CNAME target for custom domains: explains configuration, serves nothing else.
portals.{$PLATFORM_DOMAIN} {
	import security_headers
	respond "This hostname is the CNAME target for Unitforma portals." 200
}

# Tenant subdomains ride the wildcard certificate (DNS-01) — no per-tenant ACME quota.
*.{$PLATFORM_DOMAIN} {
	tls {
		dns cloudflare {file./run/secrets/dns_provider_token}
	}
	import security_headers
	import api_routes
	handle {
		reverse_proxy web-portal:8080
	}
}

# Developer-owned custom domains: certificate on demand after the API verified ownership.
https:// {
	tls {
		on_demand
	}
	import security_headers
	import api_routes
	handle {
		reverse_proxy web-portal:8080
	}
}

http:// {
	respond "Unknown host" 421
}
