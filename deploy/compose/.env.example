# Copy to .env next to the compose files. Non-secret configuration only; secrets go in ./secrets/.
UF_ENVIRONMENT=production
UF_LOG_LEVEL=INFO

# Hosts
PLATFORM_DOMAIN=unitforma.com
ADMIN_HOST=app.unitforma.com
PORTALS_CNAME_TARGET=portals.unitforma.com
ACME_EMAIL=ops@unitforma.com

# Image tags (git SHA tags from CI; never "latest" in production)
BACKEND_TAG=sha-0000000
FRONTEND_TAG=sha-0000000
PROXY_TAG=sha-0000000
BACKUP_TAG=sha-0000000

# Pinned infrastructure versions
KRATOS_VERSION=v26.2.0
POSTGRES_VERSION=18
GARAGE_VERSION=v2.5.0
MAILPIT_VERSION=v1.28

# Storage
S3_BUCKET=unitforma

# Backups
BACKUP_CRON=0 2 * * *
BACKUP_RCLONE_REMOTE=offsite:unitforma-backups
BACKUP_RETENTION_DAYS=30
