# Production template: copy to .env next to the compose files on a production host. The dev stack runs
# without .env (the defaults in compose.yaml are the dev values). Non-secret configuration only; secrets go in ./secrets/.
UF_ENVIRONMENT=production
UF_LOG_LEVEL=INFO

# Hosts
PLATFORM_DOMAIN=unitforma.com
ADMIN_HOST=app.unitforma.com
PORTALS_CNAME_TARGET=portals.unitforma.com
ACME_EMAIL=ops@unitforma.com

# Image tags (git SHA tags from CI; never "latest" in production)
BACKEND_TAG=sha-0000000
FRONTEND_TAG=sha-0000000
PROXY_TAG=sha-0000000
BACKUP_TAG=sha-0000000

# Pinned infrastructure versions
KRATOS_VERSION=v26.2.0
POSTGRES_VERSION=18
GARAGE_VERSION=v2.5.0
MAILPIT_VERSION=v1.28

# Storage (prod: Garage behind https://s3.<platform-domain> for browser presigned URLs; dev overrides use the local backend)
S3_BUCKET=unitforma
STORAGE_BACKEND=s3
S3_PUBLIC_URL=https://s3.unitforma.com

# Backups
BACKUP_CRON=0 2 * * *
BACKUP_RCLONE_REMOTE=offsite:unitforma-backups
BACKUP_RETENTION_DAYS=30
# Project bootstrap from a tas.ge building permit (ADR-0007); false hides the card and returns 404
UF_REGULATORY_TASGE_ENABLED=true
# MCP server for staff assistants at https://app.<platform-domain>/mcp (ADR-0015); false answers 404
UF_MCP_ENABLED=true
# Portal map: the OpenStreetMap iframe around a project's position; false = address and link only
# (the switch for the day the OSMF tile policy withdraws access; see docs/runbooks/deploy.md)
UF_PORTAL_MAP_EMBED=true
# AI-generated 3D plan renders (ADR-0017): none hides the feature. With gemini, put the API key
# in secrets/ai_image_api_key; the model id and the per-tenant daily cap are settings too.
UF_AI_IMAGE_PROVIDER=gemini
UF_AI_IMAGE_MODEL=gemini-nano-banana-2.1
UF_AI_IMAGE_DAILY_LIMIT=40
